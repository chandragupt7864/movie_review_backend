BGM_AUDIO_ANALYSIS_ENABLED=true
BGM_FINGERPRINT_ENABLED=true
BGM_RECOGNITION_ENABLED=true
VOICE_VOLUME=1.0
BGM_FADE_OUT_SECONDS=3
SHORTS_SET_FINAL_VIDEO_PATH=true
