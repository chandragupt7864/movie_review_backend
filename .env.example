SHORTS_FOREGROUND_ZOOM_WITH_CROP=1.70
SHORTS_FOREGROUND_WIDTH_NO_CROP=1020
SHORTS_FOREGROUND_WIDTH_WITH_CROP=1220
SHORTS_FOREGROUND_Y_OFFSET=0
SHORTS_FOREGROUND_X_CENTER=true
SHORTS_FOREGROUND_Y_CENTER=true
