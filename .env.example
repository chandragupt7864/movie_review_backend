SCENE_TRAILER_OUTRO_SKIP_SECONDS=15
TMDB_UPCOMING_START_DATE=
TMDB_UPCOMING_END_DATE=
TMDB_RELEASED_START_DATE=
TMDB_RELEASED_END_DATE=
TMDB_MIN_VOTE_AVERAGE=6.0
TMDB_MIN_VOTE_COUNT=50
TMDB_MIN_UPCOMING_POPULARITY=20
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SCRIPT_PROVIDER=gemini
INTERNET_SSL_VERIFY=true
