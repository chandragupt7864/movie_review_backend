TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here
TMDB_REGION=US
DATABASE_URL=postgresql://postgres:password@localhost:5432/movie_review_agent
TMDB_SSL_VERIFY=false
TMDB_CA_BUNDLE=
TMDB_USE_ENV_PROXY=true
TMDB_RETRY_COUNT=3
TMDB_TIMEOUT_SECONDS=30
TMDB_FORCE_IPV4=false
WATCHDOG_INTERVAL_SECONDS=300
