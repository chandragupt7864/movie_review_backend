SUPABASE_AUDIO_BUCKET=movie-audio
SUPABASE_BGM_BUCKET=bgm-library
UPLOAD_AUDIO_TO_SUPABASE=true
SUPABASE_AUDIO_KEEP_LAST=20
AUDIO_CLEANUP_ENABLED=true
DELETE_LOCAL_AUDIO_AFTER_UPLOAD=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LYRIA_MODEL=lyria-3.5
LYRIA_TIMEOUT_SECONDS=300
LYRIA_OUTPUT_DIR=storage/bgm/generated
GEMINI_GENERATE_TIMEOUT_SECONDS=480
GEMINI_FILE_PROCESSING_TIMEOUT_SECONDS=180
GEMINI_SCENE_MAX_VIDEOS=1
VIDEO_SOURCE_DIR=storage/source_videos
VIDEO_RENDER_DIR=storage/final_videos
FINAL_VIDEO_DIR=storage/final_videos
TEMP_CLIP_DIR=storage/temp_clips
SCENE_DETECTION_THRESHOLD=27.0
SCENE_EXTRA_SECONDS_AFTER_VOICE=7
SCENE_EXTRA_SECONDS_MIN=5
SCENE_EXTRA_SECONDS_MAX=10
SCENE_SELECTION_PREFER_VISUAL_FALLBACK=false
SCENE_ALLOW_VISUAL_FALLBACK_ON_GEMINI_ERROR=true
SCENE_OUTPUT_FORMAT=16:9
SCENE_MASTER_RESOLUTION=1920x1080
MASTER_VIDEO_RESOLUTION=1920x1080
MASTER_VIDEO_FPS=30
MASTER_VIDEO_CRF=20
MASTER_VIDEO_PRESET=veryfast
RENDER_KEEP_TEMP_CLIPS=false
SOURCE_VIDEO_MAX_SIZE_MB=500
SOURCE_VIDEO_MIN_ASPECT_RATIO=1.70
SOURCE_VIDEO_MAX_ASPECT_RATIO=1.85
CUT_MERGE_TARGET_FPS=60
GEMINI_SSL_VERIFY=true
DOWNLOAD_TRAILER_AUTOMATICALLY=true
VIDEO_DOWNLOADER_MAX_VIDEOS=3
VIDEO_DOWNLOADER_MAX_ATTEMPTS=3
YT_DLP_RETRY_ATTEMPTS=3
YT_DLP_SOCKET_TIMEOUT_SECONDS=30
YT_DLP_POT_PROVIDER_ENABLED=false
YT_DLP_COOKIE_FILE=storage/private/youtube_cookies.txt
